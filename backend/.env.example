# Copy to .env for local dev. In production, set these as real environment
# variables on the host/platform instead of using a file.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=8080
ALLOWED_ORIGINS=http://localhost:5183

# Optional: creates this user on startup if it doesn't already exist yet.
# Safe to remove after the first run.
SEED_USERNAME=
SEED_PASSWORD=

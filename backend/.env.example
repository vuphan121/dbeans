# Copy to .env for local dev. In production, set these as real environment
# variables on the host/platform instead of using a file.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# Optional: creates this user on startup if it doesn't already exist yet.
# Safe to remove after the first run.
SEED_USERNAME=
SEED_PASSWORD=

# Shared secret for GET /api/jobs/tick — the one URL you paste into
# cron-job.org (or any external scheduler) to drive scheduled queries.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Required. Encrypts saved connection credentials (fields/dsn) at rest —
# independent of any user's login password, so changing a password never
# needs to re-encrypt anything. Generate one with: openssl rand -hex 32
# Losing this key makes every saved connection's credentials unrecoverable.
CONNECTION_ENCRYPTION_KEY=
